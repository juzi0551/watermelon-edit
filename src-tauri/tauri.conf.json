{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-config-schema/schema.json",
  "productName": "西瓜审校",
  "version": "0.1.0",
  "identifier": "com.watermelon-edit.app",
  "build": {
    "devUrl": "http://localhost:5173",
    "frontendDist": "../backend/static"
  },
  "app": {
    "windows": [
      {
        "title": "西瓜审校",
        "width": 1280,
        "height": 860,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/watermelon-server"]
  },
  "plugins": {
    "shell": {
      "sidecar": [
        {
          "name": "watermelon-server",
          "args": true
        }
      ]
    }
  }
}
